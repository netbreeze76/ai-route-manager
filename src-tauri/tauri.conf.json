{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Route Manager",
  "version": "1.0.6",
  "identifier": "com.airoute.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Route Manager · 智能分流管家",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://139-59-246-27.sslip.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/engine/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQkE4MEY4QUVCRjQ4OEQKUldTTlNMK3UrSUM2bmU5R0FaMk04RVAzL1pQditzN21ZN0ZncXVscVY1bVlrV2RUVHZKREx2bHoK",
      "endpoints": [
        "https://139-59-246-27.sslip.io/ai-route-manager/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
